<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Pločica</title>
    <meta name="description" content="Pločica — ručno rađene keramičke pločice. Zagreb." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=PT+Sans+Narrow:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Preskoči na sadržaj</a>

    <div id="header-sentinel" style="position: absolute; top: 0; width: 1px; height: 1px;" aria-hidden="true"></div>

    <header class="site-header">
        <div class="container">
            <a class="brand" asp-page="/Index">
                <img src="~/img/logoNavbar.svg" alt="Pločica" />
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-primary" aria-label="Otvori izbornik">
                <span class="nav-toggle-icon" aria-hidden="true"></span>
            </button>

            <ul class="nav-primary" id="nav-primary">
                <li class="nav-item-dropdown" aria-expanded="false">
                    <a class="nav-dropdown-toggle" asp-page="/Kolekcije" aria-haspopup="true">
                        Kolekcije <span class="chevron" aria-hidden="true"></span>
                    </a>
                    <ul class="nav-dropdown">
                        <li><a asp-page="/Kolekcije" asp-fragment="oblici">Oblici</a></li>
                        <li><a asp-page="/Kolekcije" asp-fragment="oslikane">Ručno oslikane</a></li>
                        <li><a asp-page="/Kolekcije" asp-fragment="reljefne">Reljefne</a></li>
                        <li><a asp-page="/Kolekcije" asp-fragment="boje">Karta boja</a></li>
                    </ul>
                </li>
                <li><a class="nav-link" asp-page="/Radovi">Radovi</a></li>
                <li><a class="nav-link" asp-page="/ONama">O nama</a></li>
                <li><a class="nav-link" asp-page="/Faq">FAQ</a></li>
                <li class="nav-cta"><a class="btn btn-cta" href="@SiteLinks.ContactForm" target="_blank" rel="noopener noreferrer">Stvorimo nešto zajedno</a></li>
            </ul>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <picture>
            <source media="(max-width: 860px)" srcset="@Url.Content("~/img/logoOnBrickMobile.jpg")" />
            <img class="footer-logo" src="~/img/logoOnBrick.jpg" alt="Pločica" />
        </picture>
        <div class="container footer-content">
            <div class="footer-columns">
                <nav class="footer-links" aria-label="Stranice">
                    <a asp-page="/Kolekcije">Kolekcije</a>
                    <a asp-page="/Radovi">Radovi</a>
                    <a asp-page="/ONama">O nama</a>
                    <a asp-page="/Faq">FAQ</a>
                    <a asp-page="/Kontakt">Kontakt</a>
                </nav>

                <div class="footer-meta">
                    <a href="mailto:plocica.info@gmail.com">plocica.info@gmail.com</a>

                    <div class="footer-social">
                        <a class="footer-social-link" href="https://instagram.com/plocica_" target="_blank" rel="noopener" aria-label="Instagram @@plocica_">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                                <circle cx="12" cy="12" r="4.5" />
                                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                            </svg>
                        </a>

                        <!-- TODO: swap href once the Facebook page URL is provided -->
                        <a class="footer-social-link" href="#" target="_blank" rel="noopener" aria-label="Facebook Pločica">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <circle cx="12" cy="12" r="9.5" />
                                <g transform="translate(4.04 3.01) scale(0.65)" fill="currentColor" stroke="none">
                                    <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.732-.009c-.703 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 3.667h-3.533v7.98H9.101z" />
                                </g>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <p class="footer-note">Hvala vam što ste odvojili vrijeme za istraživanje naše kolekcije. Svaka pločica nastaje ručno, s posebnom pažnjom prema detaljima, materijalu i prostoru kojem je namjenjena.</p>

            <div class="footer-copy">&copy; @DateTime.Now.Year Pločica, Zagreb | made by Gita</div>
        </div>
    </footer>

    <script src="~/js/nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

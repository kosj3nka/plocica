@page "{id:int?}"
@model Plocica.Pages.Admin.Boje.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "Nova boja" : "Uredi boju";
}

<div class="admin-container">
    <a class="admin-back" asp-page="Index">← Boje</a>
    <h1>@(Model.Id is null ? "Nova boja" : "Uredi boju")</h1>

    <form method="post" enctype="multipart/form-data" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="admin-alert"></div>

        <div class="admin-field-row">
            <div class="admin-field">
                <label asp-for="Input.Code">Kod</label>
                <input asp-for="Input.Code" placeholder="npr. 001" />
                <span asp-validation-for="Input.Code" class="admin-field-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Input.Name">Naziv (opcionalno)</label>
                <input asp-for="Input.Name" placeholder="npr. Warm Sun" />
            </div>
        </div>

        <div class="admin-field">
            <label>Tip</label>
            <div class="admin-toggle">
                <label><input type="radio" asp-for="Input.Mode" value="color" data-toggle-target="color" /> Boja</label>
                <label><input type="radio" asp-for="Input.Mode" value="image" data-toggle-target="image" /> Slika</label>
            </div>
        </div>

        <div class="admin-field admin-toggle-panel" data-panel="color">
            <label asp-for="Input.Hex">Boja</label>
            <input asp-for="Input.Hex" type="color" />
            <span asp-validation-for="Input.Hex" class="admin-field-error"></span>
        </div>

        <div class="admin-field admin-toggle-panel" data-panel="image">
            <label>Slika</label>
            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
            {
                <img src="@Model.ExistingImageUrl" alt="" class="admin-thumb-preview" />
            }
            <input asp-for="Input.ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="Input.ImageFile" class="admin-field-error"></span>
            <p class="admin-hint">JPG, PNG ili WEBP, do 5 MB.</p>
        </div>

        <div class="admin-field">
            <label asp-for="Input.SortOrder">Redoslijed</label>
            <input asp-for="Input.SortOrder" type="number" />
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-cta">Spremi</button>
            <a asp-page="Index" class="btn">Odustani</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/admin-color-toggle.js" asp-append-version="true"></script>
}

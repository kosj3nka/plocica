@page
@model Plocica.Pages.RadoviModel
@{
    ViewData["Title"] = "Radovi";
}

<section class="section-invert about-photo heading-photo">
    <img class="about-photo-img" src="~/img/lego.jpg" alt="Slog neglaziranih keramičkih pločica s reljefnim kvadratnim uzorkom." loading="lazy">
    <div class="about-photo-overlay"></div>
    <div class="container about-photo-content heading-photo-content">
        <p class="eyebrow">Custom projekti</p>
        <h1>Radovi</h1>
    </div>
</section>

<section class="container">
    @for (int i = 0; i < Model.Projects.Count; i++)
    {
        var project = Model.Projects[i];
        <article class="project">
            <div class="project-header">
                <p class="eyebrow">@((i + 1).ToString("00"))</p>
                <h2>@project.Title</h2>
                @if (!string.IsNullOrEmpty(project.Location))
                {
                    <p class="project-location">@project.Location</p>
                }
                <p class="project-text">@project.Text</p>
            </div>

            @if (project.Images.Any())
            {
                const int maxVisible = 4;
                <div class="project-gallery">
                    @for (var j = 0; j < project.Images.Count; j++)
                    {
                        var image = project.Images[j];
                        <img src="@image.Url" alt="@project.Title" loading="lazy" class="@(j >= maxVisible ? "project-gallery-extra" : null)">
                    }
                </div>
                @if (project.Images.Count > maxVisible)
                {
                    <button type="button" class="project-gallery-more" data-gallery-more aria-expanded="false" data-label-more="Prikaži sve fotografije (@project.Images.Count)" data-label-less="Prikaži manje">Prikaži sve fotografije (@project.Images.Count)</button>
                }
            }
            else
            {
                <div class="project-placeholder">Fotografije dolaze uskoro</div>
            }
        </article>
    }
</section>


@await Html.PartialAsync("_CtaSection", "~/img/rawTiles.jpg")

@section Scripts {
    <script src="~/js/project-gallery.js" asp-append-version="true"></script>
    <script src="~/js/project-reveal.js" asp-append-version="true"></script>
}

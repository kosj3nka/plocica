@model List<Plocica.Models.Shape>
@functions {
    static string FormatCm(decimal? value)
    {
        if (value is null) return string.Empty;
        return value.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',');
    }
}

<div class="shape-icon-grid" style="--cols-sm: @GridLayout.BestColumns(Model.Count, 4); --cols-md: @GridLayout.BestColumns(Model.Count, 5); --cols-lg: @GridLayout.BestColumns(Model.Count, 7);">
    @foreach (var shape in Model)
    {
        <button type="button" class="shape-icon-tile" aria-expanded="false" aria-controls="shape-details-@shape.Id">
            @if (!string.IsNullOrEmpty(shape.ImageUrl))
            {
                <img src="@shape.ImageUrl" alt="@shape.Name oblik" loading="lazy">
            }
            else
            {
                <div class="shape-icon-empty"></div>
            }
            <span class="shape-icon-name">@shape.Name</span>
        </button>
    }
</div>

<div class="shape-details-wrap">
    @foreach (var shape in Model)
    {
        var layoutImages = shape.GalleryImages
            .Where(g => g.Kind == Plocica.Models.ShapeGalleryImage.KindLayout)
            .OrderBy(g => g.SortOrder)
            .ToList();

        var hasHeight = shape.DimensionHeight.HasValue;
        var hasWidth = shape.DimensionWidth.HasValue;
        var hasDimensions = hasHeight || hasWidth;
        string? dimHeight = hasHeight ? $"{FormatCm(shape.DimensionHeight)} cm" : null;
        string? dimWidth = hasWidth ? $"{FormatCm(shape.DimensionWidth)} cm" : null;
        string? dimPlain = hasHeight && hasWidth
            ? $"{FormatCm(shape.DimensionHeight)} × {FormatCm(shape.DimensionWidth)} cm"
            : (dimHeight ?? dimWidth);

        <div class="shape-details" id="shape-details-@shape.Id" hidden>
            <div class="shape-details-grid">
                @if (!string.IsNullOrEmpty(shape.PhotoUrl) || !string.IsNullOrEmpty(shape.Price) || !string.IsNullOrEmpty(shape.OtherInfo))
                {
                    <div class="shape-details-photo-col">
                        @if (!string.IsNullOrEmpty(shape.PhotoUrl))
                        {
                            <figure class="shape-details-photo">
                                <img src="@shape.PhotoUrl" alt="@shape.Name u prostoru" loading="lazy">
                            </figure>
                        }
                        @if (!string.IsNullOrEmpty(shape.Price))
                        {
                            <p class="shape-details-price"><span class="eyebrow">Cijena</span>@shape.Price</p>
                        }
                        @if (!string.IsNullOrEmpty(shape.OtherInfo))
                        {
                            <p class="shape-details-price"><span class="eyebrow">Ostale info</span>@shape.OtherInfo</p>
                        }
                    </div>
                }
                <div class="shape-details-info">
                    <div class="shape-details-heading">
                        <h3>@shape.Name</h3>
                        <p class="eyebrow">Tehničke informacije</p>
                    </div>
                    <dl class="spec-dl">
                        @if (hasDimensions || shape.Thickness.HasValue)
                        {
                            <div>
                                <dt>Dimenzija</dt>
                                <dd>
                                    <div class="shape-dim-row">
                                        @if (hasHeight && hasWidth && !string.IsNullOrEmpty(shape.ImageUrl))
                                        {
                                            <div class="shape-dim">
                                                <img src="@shape.ImageUrl" alt="@shape.Name oblik" class="shape-dim-icon">
                                                <span class="shape-dim-vline"></span>
                                                <span class="shape-dim-vvalue">@dimHeight</span>
                                                <span class="shape-dim-hline"></span>
                                                <span class="shape-dim-hvalue">@dimWidth</span>
                                            </div>
                                        }
                                        else if (hasDimensions)
                                        {
                                            <span class="shape-dim-plain">@dimPlain</span>
                                        }
                                        @if (shape.Thickness.HasValue)
                                        {
                                            <div class="shape-thickness">
                                                <span class="eyebrow">Debljina</span>
                                                <span>@FormatCm(shape.Thickness) cm</span>
                                            </div>
                                        }
                                    </div>
                                </dd>
                            </div>
                        }
                        @if (layoutImages.Any())
                        {
                            <div>
                                <dt>Shema slaganja</dt>
                                <dd>
                                    <div class="shape-pattern-grid" style="--cols-lg: @GridLayout.BestColumns(layoutImages.Count, 2);">
                                        @foreach (var image in layoutImages)
                                        {
                                            <img src="@image.ImageUrl" alt="Shema slaganja @shape.Name" class="shape-pattern-img" loading="lazy">
                                        }
                                    </div>
                                </dd>
                            </div>
                        }
                    </dl>
                </div>
            </div>

            @if (shape.Examples.Any())
            {
                <div class="shape-examples">
                    <div class="shape-examples-grid" style="--cols-lg: @GridLayout.BestColumns(shape.Examples.Count, 5);">
                        @foreach (var example in shape.Examples.OrderBy(e => e.SortOrder))
                        {
                            <figure class="shape-example">
                                <img src="@example.ImageUrl" alt="@example.Name" loading="lazy">
                                <figcaption>@example.Name</figcaption>
                            </figure>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@page
@model Plocica.Pages.RadoviModel
@{
    ViewData["Title"] = "Radovi";
}

<section class="section container">
    <p class="eyebrow">Custom projekti</p>
    <h1>Radovi</h1>
</section>

<section class="container">
    @for (int i = 0; i < Model.Projects.Count; i++)
    {
        var project = Model.Projects[i];
        <article class="project">
            <div class="project-header">
                <p class="eyebrow">@((i + 1).ToString("00"))</p>
                <h2>@project.Title</h2>
                @if (!string.IsNullOrEmpty(project.Location))
                {
                    <p class="project-location">@project.Location</p>
                }
                <p class="project-text">@project.Text</p>
            </div>

            @if (project.Images.Any())
            {
                <div class="project-gallery">
                    @foreach (var image in project.Images)
                    {
                        <img src="@image.Url" alt="@project.Title" loading="lazy">
                    }
                </div>
            }
            else
            {
                <div class="project-placeholder">Fotografije dolaze uskoro</div>
            }
        </article>
    }
</section>

<section class="section section-alt hairline-top">
    <div class="container">
        <div class="collection-intro">
            <div>
                <p class="eyebrow">Odabir posebnog motiva</p>
                <h2 style="max-width: 20ch;">Za prostore koji traže više od standardnih rješenja.</h2>
                <p style="max-width: 54ch; color: var(--ink-soft); font-size: 1.0625rem;">Razvijamo potpuno custom pločice i kolekcije prilagođene projektu. Svaki projekt prolazi zaseban proces razvoja, a rokovi i cijene definiraju se individualno prema kompleksnosti izvedbe.</p>
            </div>
            <figure>
                <img src="~/img/motivCustom.jpg" alt="Ručno oslikane keramičke pločice s ornamentalnim motivom u crvenoj, žutoj i ljubičastoj boji." loading="lazy">
            </figure>
        </div>
    </div>
</section>

@await Html.PartialAsync("_CtaSection", "~/img/rawTiles.jpg")

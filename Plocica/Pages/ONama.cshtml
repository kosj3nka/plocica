@page "/o-nama"
@model Plocica.Pages.ONamaModel
@{
    ViewData["Title"] = "O nama";
}

@section Styles {
    <link rel="stylesheet" href="~/css/onama.css" asp-append-version="true" />
}

<section class="section container about-hero">
    <div class="about-hero-trio">
        <figure class="trio-photo trio-photo-left">
            <img src="~/img/baked.jpg" alt="Ručno oblikovane pločice na radnoj ploči, spremne za pečenje." loading="lazy">
        </figure>
        <div class="trio-col-middle">
            <h1>O nama</h1>
            <figure class="trio-photo trio-photo-middle">
                <img src="~/img/vlasniciRad.jpg" alt="Lorena i Mihael u radionici, okruženi alatima i uzorcima pločica." loading="lazy">
            </figure>
        </div>
        <figure class="trio-photo trio-photo-right">
            <img src="~/img/working1.jpg" alt="Mihael oblikuje glinu na stroju za obradu keramike." loading="lazy">
        </figure>
    </div>

    <p class="lede">Mi smo <strong>Lorena i Mihael</strong>, duo iza studija Pločica.
Kroz spoj kreativnog i tehničkog pristupa razvijamo
keramičke pločice.
</p>
</section>

<section class="section-invert about-photo">
    <img class="about-photo-img" src="~/img/happyProcess.jpg" alt="Lorena i Mihael nasmiješeni tijekom rada u radionici." loading="lazy">
    <div class="about-photo-overlay"></div>
    <div class="container about-photo-content pristup-intro">
        <p class="pristup-line pristup-line-1">Lorena dolazi iz umjetničkog svijeta i fokus stavlja na formu, boju, kompoziciju i detalje,</p>
        <p class="pristup-line pristup-line-2">dok Mihael razvija proizvodni proces i tehničku izvedbu koja omogućuje da svaka ideja zaživi u prostoru.</p>
    </div>
</section>

<section class="section hairline-bottom" style="padding-bottom: 0;">
    <div class="container">
        <p class="eyebrow">Studio</p>
        <h2 style="max-width: 24ch;">Prostor u kojem sve nastaje, pločica po pločica.</h2>
    </div>
    <div class="craft-process-row craft-process-row-compact" style="margin-top: var(--space-fluid-md);">
        <img src="~/img/procesGlazure.jpg" alt="Lorena i Mihael sjede ispod zida s izloženim ručno oslikanim pločicama u radionici." loading="lazy">
        <img src="~/img/founders2.jpg" alt="Lorena naslonjena na Mihaelovo rame, okruženi policama s glaziranim pločicama u zelenim i žutim tonovima." loading="lazy">
        <img src="~/img/working2.jpg" alt="Lorena i Mihael za radnim stolom, s kalupom za izradu pločice u rukama." loading="lazy">
    </div>
</section>

<section class="section container">
    <div class="philosophy-row">
        <div>
            <p class="eyebrow">Filozofija</p>
            <h2 class="philosophy-title" style="max-width: 20ch;">Kreativnost nije rezervirana samo za umjetnike i dizajnere.</h2>
            <p class="philosophy-lede" style="max-width: 62ch; color: var(--ink-soft);">Kroz handmade proces i mogućnost kombiniranja boja i formata stvaramo pločice koje ljudima daju slobodu da oblikuju prostor na osoban način i unesu vlastiti karakter u prostor u kojem žive.</p>
        </div>
        <figure class="philosophy-photo">
            <img src="~/img/foundersSmiling.jpg" alt="Lorena i Mihael nasmiješeni u radionici." loading="lazy">
        </figure>
    </div>

    <div class="hairline-top" style="margin-top: 2rem; padding-top: 1.5rem;">
        <p class="eyebrow">Za koga radimo</p>
        <p style="max-width: 56ch; color: var(--ink-soft);">Radimo s arhitektima, dizajnerima interijera i privatnim klijentima koji traže autentične, ručno rađene materijale i individualan pristup prostoru.</p>
    </div>

    <div class="hairline-top" style="margin-top: 2rem; padding-top: 1.5rem;">
        <p class="eyebrow">Pločica u medijima – click to read</p>
        <div class="media-row">
            <a href="https://www.journal.hr/kultura/umjetnost-i-dizajn/plocica-studio-keramike/" target="_blank" rel="noopener" aria-label="Journal">
                <img src="~/img/journal.png" alt="Journal">
            </a>
            <a href="https://buro247.hr/brend-plocica-intervju/" target="_blank" rel="noopener" aria-label="Buro">
                <img src="~/img/buro.png" alt="Buro">
            </a>
            <a href="https://www.jutarnji.hr/domidizajn/inspiracije/lorena-i-mihael-jedini-u-hrvatskoj-rucno-izraduju-umjetnicke-keramicke-plocice-za-zid-odusevljeni-smo-15499539" target="_blank" rel="noopener" aria-label="D&amp;D">
                <img src="~/img/dom-i-dizajn.png" alt="D&amp;D">
            </a>
            <a href="https://indizajn.net.hr/inspiracija/noviteti/indizajn-talk-upoznajte-mihaela-i-lorenu-koji-dizajniraju-i-izraduju-plocice/" target="_blank" rel="noopener" aria-label="InDizajn">
                <img src="~/img/indizajn-logo.png" alt="InDizajn">
            </a>
            <a href="https://www.dom2.hr/lifestyle/ove-mastovite-unikatne-keramicke-plocice-plod-su-zanimljive-suradnje-mladog-para/" target="_blank" rel="noopener" aria-label="Dom na kvadrat">
                <img class="media-logo-light" src="~/img/dom-na-kvadrat.png" alt="Dom na kvadrat">
            </a>
            <a href="https://after5.hr/zivot-prije-5/plocica/" target="_blank" rel="noopener" aria-label="After5">
                <img class="media-logo-light" src="~/img/after5.svg" alt="After5">
            </a>
            <a class="media-text-link" href="https://vizkultura.hr/intervju-studio-plocica/" target="_blank" rel="noopener">VIZKULTURA</a>
        </div>
    </div>
</section>

@await Html.PartialAsync("_CtaSection", "~/img/rawTiles.jpg")

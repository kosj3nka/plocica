@page
@model Plocica.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="admin-login">
    <h1>Pločica admin</h1>
    <form method="post" novalidate>
        @if (Model.ErrorMessage is not null)
        {
            <p class="admin-alert">@Model.ErrorMessage</p>
        }
        <div class="admin-field">
            <label asp-for="Input.Username">Korisničko ime</label>
            <input asp-for="Input.Username" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Username" class="admin-field-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Input.Password">Lozinka</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="admin-field-error"></span>
        </div>
        <button type="submit" class="btn btn-cta">Prijavi se</button>
    </form>
</div>
